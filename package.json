{
  "name": "start-android-emulator",
  "version": "3.0.2",
  "description": "A simple library to start an Android emulator on your local machine",
  "bin": {
    "start-android-emulator": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "release": "np"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wswebcreation/start-android-emulator.git"
  },
  "keywords": [
    "Android",
    "cli",
    "emulator"
  ],
  "author": "wswebcreation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wswebcreation/start-android-emulator/issues"
  },
  "homepage": "https://github.com/wswebcreation/start-android-emulator#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "np": "^12.1.1",
    "typescript": "^7.0.2"
  }
}